/** Targeted suites, disposable databases only. No personal .env or .data is opened. */
import {spawn,ChildProcess} from 'node:child_process';
import {mkdtemp,mkdir,symlink,rm} from 'node:fs/promises';
import {randomBytes} from 'node:crypto';
import {once} from 'node:events';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
const project=fileURLToPath(new URL('..',import.meta.url)),runtime=await mkdtemp('/tmp/chkpt-target-'),password=randomBytes(24).toString('hex'),children=new Set<ChildProcess>();
async function start(name:string,demo=true){const cwd=path.join(runtime,name);await mkdir(cwd,{recursive:true});try{await symlink(path.join(project,'dist'),path.join(cwd,'dist'));}catch(e:any){if(e.code!=='EEXIST')throw e;}
 const child=spawn(process.execPath,['--import',path.join(project,'node_modules/tsx/dist/loader.mjs'),path.join(project,'server.ts')],{cwd,env:{...process.env,CHKPT_DATA_DIR:path.join(cwd,'.data'),NODE_ENV:'production',HOST:'127.0.0.1',PORT:'0',CHKPT_REMOTE_ACCESS:'false',CHKPT_PRIVATE_DEMO:String(demo),CHKPT_DEMO_ADMIN_PASSWORD:demo?password:''},stdio:['ignore','pipe','pipe']});children.add(child);let logs='';child.stdout!.on('data',d=>logs+=d);child.stderr!.on('data',d=>logs+=d);for(let i=0;i<400;i++){const url=logs.match(/running at (http:\/\/[^\s]+)/)?.[1];if(url)return {url,child,cwd};if(child.exitCode!==null)throw Error(logs);await new Promise(r=>setTimeout(r,50));}throw Error('Serveur temporaire non prêt.');}
async function stop(child:ChildProcess){if(child.exitCode===null&&child.signalCode===null){const done=once(child,'exit');child.kill('SIGTERM');await done;}children.delete(child);}
const suites:Record<string,[string,string,'api'|'browser']>={permanent:['permanent_demo_stories.test','checkPermanentDemoStories','api'],stories:['stories_test','checkStories','api'],scroll:['stories_scroll_browser','checkStoriesScroll','browser'],supervisor:['supervisor_stories_dm.test','checkSupervisorSocial','api'],authrace:['auth_modal_race','checkAuthModalTimer','browser'],demo4:['demo_profiles_browser','checkDemoProfileBrowsers','browser'],social:['nov9_social.test','checkNov9Social','api'],places:['nov9_places.test','checkNov9Places','api'],retro:['nov9_retro.test','checkNov9Retro','api'],browser:['nov9_browser','checkNov9Browser','browser'],profile:['profile_browser','checkProfile','browser'],radar:['radar_browser','checkRadarMap','browser'],features:['next_features_browser','checkNextFeatures','browser'],media:['post_media_browser','checkPostMedia','browser'],messages:['messages_browser','checkMessages','browser'],presentation:['presentation_browser','checkPresentation','browser'],navigation:['navigation_search_browser','checkNavigationSearch','browser'],newux:['ux_lots_browser','checkUxLots','browser']};
try{for(const name of process.argv.slice(2).length?process.argv.slice(2):['social','places','retro','browser']){const suite=suites[name];if(!suite)throw Error('Suite inconnue : '+name);const [file,fn,mode]=suite;console.log('START '+name);const mod=await import(path.join(project,'tests',file+'.ts'));if(mode==='api')await mod[fn](start,stop,password);else{const server=await start('browser-'+name);try{await mod[fn](server.url,password);}finally{await stop(server.child);}}console.log('PASS '+name);}}
finally{for(const child of children)await stop(child);await rm(runtime,{recursive:true,force:true});}
